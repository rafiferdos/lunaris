{
  "name": "lunaris",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-vad.mjs && next dev",
    "build": "node scripts/prepare-vad.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "api:generate": "openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts && prettier --write lib/api/schema.d.ts",
    "test:e2e": "playwright test",
    "api:sync": "node --env-file-if-exists=.env.local scripts/sync-api.mjs && pnpm api:generate",
    "format:check": "prettier --check app components features hooks lib scripts tests playwright.config.ts next.config.ts eslint.config.mjs package.json pnpm-workspace.yaml README.md docs .github/workflows",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.1"
}
